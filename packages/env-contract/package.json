{
  "name": "env-contract",
  "version": "0.2.0",
  "description": "Keep your env schema, .env.example, and process.env references honest with each other.",
  "keywords": [
    "env",
    "dotenv",
    "env-example",
    "environment-variables",
    "zod",
    "t3-env",
    "valibot",
    "arktype",
    "standard-schema",
    "validation",
    "typescript",
    "monorepo",
    "ci"
  ],
  "homepage": "https://github.com/alranjan14/env-contract#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alranjan14/env-contract.git"
  },
  "bugs": "https://github.com/alranjan14/env-contract/issues",
  "author": "alranjan14",
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "env-contract": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check-package": "vitest run tests/package-contents.test.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "cac": "^6.7.14",
    "jiti": "^2.1.0",
    "oxc-parser": "^0.140.0",
    "picocolors": "^1.0.0"
  },
  "peerDependencies": {
    "@t3-oss/env-core": ">=0.9.0",
    "@t3-oss/env-nextjs": ">=0.9.0",
    "arktype": "^2.0.0",
    "valibot": "^1.0.0",
    "zod": "^3.0.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@t3-oss/env-core": {
      "optional": true
    },
    "@t3-oss/env-nextjs": {
      "optional": true
    },
    "arktype": {
      "optional": true
    },
    "valibot": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@t3-oss/env-nextjs": "^0.13.11",
    "arktype": "^2.2.0",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "valibot": "^1.4.0",
    "zod": "^3.0.0 || ^4.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
